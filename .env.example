# Environment configuration for FarmSharw Scheduler
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Payments Configuration
# Supported providers: mock, razorpay
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=mock_key_public_12345
PAYMENT_SECRET_KEY=mock_key_secret_67890
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_abcde

# Map Configuration
# Options: osm (OpenStreetMap - no API key needed), google, mapbox
MAP_PROVIDER=osm
MAP_PUBLIC_KEY=

# Localization & Business Rules
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
PLATFORM_FEE_PERCENTAGE=5.0
GST_PERCENTAGE=18.0
AUTO_CANCEL_PENDING_HOURS=24
MINIMUM_RENTAL_HOURS=2

# Security & Limits
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

